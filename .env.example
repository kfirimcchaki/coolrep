# Public origin of the deployment (used in redirect_uri and share links)
APP_URL=http://localhost:3000

# Where the JSON database and generated session secret are stored
DATA_DIR=./.data

# HMAC key for session cookies (leave empty to auto-generate into DATA_DIR)
SESSION_SECRET=

# Comma separated CORS allow-list. "*" allows every origin (no credentials echo).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://YOURUSER.github.io

# --- Null's Connect -------------------------------------------------------
# 1 = use the bundled provider (/mock-connect/authorize), 0 = connect.nulls.gg
CONNECT_MOCK=1
# CONNECT_AUTHORIZE_URL=https://connect.nulls.gg/authorize
CONNECT_CLIENT_ID=9
# CONNECT_ISSUER=
# CONNECT_JWT_SECRET=
# CONNECT_JWKS_URL=
# CONNECT_ALLOW_UNVERIFIED=0
